# Public production URL. Change if you choose a different canonical host.
NEXT_PUBLIC_SITE_URL=https://www.rpgyourway.com

# Google AdSense manual display inventory. These values are public identifiers, not secrets.
# The AdSense site code loads globally for site review and ad delivery. Leave a slot blank
# until that responsive Display ad unit exists; its reserved "Advertisements" placeholder stays visible.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-7652380497334820
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_START=
NEXT_PUBLIC_ADSENSE_SLOT_SCRIPT=
NEXT_PUBLIC_ADSENSE_SLOT_ACCESSIBILITY=

# Supabase Auth / database client configuration.
# The Vercel integration supplies these in deployment environments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Keep service-role, secret, and direct database credentials server-side only.
OPENAI_API_KEY=
# Optional text-model overrides. Gameplay can be tuned independently; other AIGM helpers use OPENAI_MODEL.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_GAMEPLAY_MODEL=gpt-5.6-terra
# Optional owner-QA command phrase. Server-side only.
RPGYW_GOD_MODE_PHRASE=
# Optional dedicated audio keys. When blank, both routes fall back to OPENAI_API_KEY.
OPENAI_AUDIO_API_KEY=
OPENAI_TTS_API_KEY=
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SHAPE_MODEL=gpt-5.6-terra

# Stripe Checkout funding for Play Packs. Keep both keys server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required by the Stripe crediting path. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Native multiplayer realtime transport (Ably app: Fivesday). Server-side only.
# The browser receives short-lived, room-scoped signed TokenRequests, never this key.
ABLY_API_KEY=
