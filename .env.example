# Public production URL. Change if you choose a different canonical host.
NEXT_PUBLIC_SITE_URL=https://www.rpgyourway.com

# Supabase Auth / database client configuration.
# The Vercel integration supplies these in deployment environments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Keep service-role, secret, and direct database credentials server-side only.
